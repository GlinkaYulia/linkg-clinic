<% content_for :title, "Вхід" %>
<div class="row justify-content-center">
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="auth-icon"><%= icon_tag "box-arrow-in-right" %></div>
        <h1 class="h4 mb-3 text-center">Вхід у систему</h1>
        <%= form_with url: login_path, method: :post do |f| %>
          <div class="mb-3">
            <%= f.label :email, "Email", class: "form-label" %>
            <%= f.email_field :email, class: "form-control", value: params[:email], autofocus: true, required: true %>
          </div>
          <div class="mb-3">
            <%= f.label :password, "Пароль", class: "form-label" %>
            <%= f.password_field :password, class: "form-control", required: true %>
          </div>
          <%= f.submit "Увійти", class: "btn btn-primary w-100" %>
        <% end %>
        <p class="mt-3 mb-0 small">Немає облікового запису? <%= link_to "Зареєструватися", register_path %></p>
      </div>
    </div>
  </div>
</div>
