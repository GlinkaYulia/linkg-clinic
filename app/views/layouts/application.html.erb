<!DOCTYPE html>
<html lang="uk">
<head>
  <title><%= content_for?(:title) ? "#{yield(:title)} — LinkG Clinic" : "LinkG Clinic" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%# Зовнішні бібліотеки (CDN): Bootstrap 5, Bootstrap Icons, шрифт Inter %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap&subset=cyrillic">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <%= stylesheet_link_tag "application" %>
  <%= stylesheet_link_tag "clinic" %>
</head>
<body class="d-flex flex-column min-vh-100">
  <nav class="navbar clinic-navbar px-3">
    <%= link_to root_path, class: "navbar-brand clinic-brand" do %>
      <%= icon_tag "heart-pulse-fill" %> LinkG Clinic
    <% end %>
    <div class="d-flex align-items-center gap-2">
      <% if current_user %>
        <span class="small text-body-secondary d-none d-sm-inline"><%= icon_tag "person-circle" %> <%= current_user.full_name %></span>
        <span class="badge rounded-pill text-bg-light border"><%= current_user.role_name %></span>
        <%= button_to logout_path, method: :delete, class: "btn btn-outline-secondary btn-sm", form_class: "d-inline" do %>
          <%= icon_tag "box-arrow-right" %> Вийти
        <% end %>
      <% else %>
        <%= link_to "Лікарі", doctors_path, class: "nav-top-link" %>
        <%= link_to "Послуги", services_path, class: "nav-top-link" %>
        <%= link_to "Контакти", contact_path, class: "nav-top-link" %>
        <%= link_to cart_path, class: "nav-top-link" do %><%= icon_tag "cart3" %> Кошик (<%= cart_count %>)<% end %>
        <%= link_to "Увійти", login_path, class: "btn btn-outline-primary btn-sm" %>
        <%= link_to "Зареєструватися", register_path, class: "btn btn-primary btn-sm" %>
      <% end %>
    </div>
  </nav>

  <div class="container-fluid flex-grow-1">
    <div class="row">
      <% if current_user %>
        <aside class="col-12 col-md-3 col-lg-2 sidebar p-0">
          <%= render "layouts/sidebar" %>
        </aside>
      <% end %>
      <main class="col p-3 p-md-4">
        <% if notice %><div class="alert alert-success d-flex align-items-center gap-2"><%= icon_tag "check-circle-fill" %> <span><%= notice %></span></div><% end %>
        <% if alert %><div class="alert alert-danger d-flex align-items-center gap-2"><%= icon_tag "exclamation-triangle-fill" %> <span><%= alert %></span></div><% end %>
        <%= yield %>
      </main>
    </div>
  </div>

  <footer class="clinic-footer">
    <div class="container-fluid px-3 px-md-4 d-flex flex-wrap justify-content-between gap-2">
      <span><strong>LinkG Clinic</strong> — інформаційно-довідкова система поліклініки</span>
      <span class="d-flex flex-wrap gap-3">
        <span><%= icon_tag "geo-alt" %> м. Івано-Франківськ, вул. Шевченка, 1</span>
        <span><%= icon_tag "telephone" %> +380 342 00-00-00</span>
        <span><%= icon_tag "clock" %> пн–пт 08:00–18:00</span>
      </span>
    </div>
  </footer>
</body>
</html>
