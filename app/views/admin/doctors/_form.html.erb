<% errors = @user.errors.full_messages + @profile.errors.full_messages %>
<% if errors.any? %>
  <div class="alert alert-danger">
    <strong>Не вдалося зберегти:</strong>
    <ul class="mb-0"><% errors.each do |m| %><li><%= m %></li><% end %></ul>
  </div>
<% end %>
<%= form_with scope: :user, model: @user, url: url, method: method do |f| %>
  <div class="mb-3">
    <%= f.label :full_name, "ПІБ", class: "form-label" %>
    <%= f.text_field :full_name, class: "form-control" %>
  </div>
  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :email, "Email (логін)", class: "form-label" %>
      <%= f.email_field :email, class: "form-control" %>
    </div>
    <div class="col-md-6 mb-3">
      <%= f.label :phone, "Телефон", class: "form-label" %>
      <%= f.telephone_field :phone, class: "form-control" %>
    </div>
  </div>
  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :password, (@user.new_record? ? "Пароль" : "Новий пароль (необов’язково)"), class: "form-label" %>
      <%= f.password_field :password, class: "form-control", autocomplete: "new-password" %>
    </div>
    <div class="col-md-6 mb-3">
      <%= f.label :password_confirmation, "Підтвердження пароля", class: "form-label" %>
      <%= f.password_field :password_confirmation, class: "form-control", autocomplete: "new-password" %>
    </div>
  </div>
  <%= fields_for :doctor_profile, @profile do |pf| %>
    <div class="row">
      <div class="col-md-6 mb-3">
        <%= pf.label :specialty_id, "Спеціальність", class: "form-label" %>
        <%= pf.collection_select :specialty_id, Specialty.order(:name), :id, :name, { include_blank: "Оберіть…" }, class: "form-select" %>
      </div>
      <div class="col-md-6 mb-3">
        <%= pf.label :room, "Кабінет", class: "form-label" %>
        <%= pf.text_field :room, class: "form-control" %>
      </div>
    </div>
    <div class="mb-3">
      <%= pf.label :consultation_price, "Вартість консультації, грн", class: "form-label" %>
      <%= pf.number_field :consultation_price, step: "0.01", min: 0, class: "form-control" %>
    </div>
    <div class="mb-3">
      <%= pf.label :bio, "Короткий опис", class: "form-label" %>
      <%= pf.text_area :bio, rows: 3, class: "form-control" %>
    </div>
  <% end %>
  <% if @user.persisted? %>
    <div class="form-check mb-3">
      <%= f.check_box :active, class: "form-check-input" %>
      <%= f.label :active, "Обліковий запис активний", class: "form-check-label" %>
    </div>
  <% end %>
  <%= f.submit "Зберегти", class: "btn btn-primary" %>
  <%= link_to "Скасувати", admin_doctors_path, class: "btn btn-link" %>
<% end %>
