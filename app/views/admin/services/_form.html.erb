<%= render "shared/errors", record: @service %>
<%= form_with model: @service, url: (@service.persisted? ? admin_service_path(@service) : admin_services_path) do |f| %>
  <div class="mb-3">
    <%= f.label :name, "Назва послуги", class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :description, "Опис", class: "form-label" %>
    <%= f.text_area :description, rows: 3, class: "form-control" %>
  </div>
  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :price, "Ціна, грн", class: "form-label" %>
      <%= f.number_field :price, step: "0.01", min: 0, class: "form-control" %>
    </div>
    <div class="col-md-6 mb-3">
      <%= f.label :specialty_id, "Спеціальність", class: "form-label" %>
      <%= f.collection_select :specialty_id, Specialty.order(:name), :id, :name, { include_blank: "Без спеціальності" }, class: "form-select" %>
    </div>
  </div>
  <div class="form-check mb-3">
    <%= f.check_box :active, class: "form-check-input" %>
    <%= f.label :active, "Послуга доступна в каталозі", class: "form-check-label" %>
  </div>
  <%= f.submit "Зберегти", class: "btn btn-primary" %>
  <%= link_to "Скасувати", admin_services_path, class: "btn btn-link" %>
<% end %>
