<%= render "shared/errors", record: @user %>
<%= form_with model: @user, url: (@user.persisted? ? admin_user_path(@user) : admin_users_path) do |f| %>
  <div class="mb-3">
    <%= f.label :full_name, "ПІБ", class: "form-label" %>
    <%= f.text_field :full_name, class: "form-control" %>
  </div>
  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :email, "Email", class: "form-label" %>
      <%= f.email_field :email, class: "form-control" %>
    </div>
    <div class="col-md-6 mb-3">
      <%= f.label :phone, "Телефон", class: "form-label" %>
      <%= f.telephone_field :phone, class: "form-control" %>
    </div>
  </div>
  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :birth_date, "Дата народження", class: "form-label" %>
      <%= f.date_field :birth_date, class: "form-control" %>
    </div>
    <% if @user.new_record? %>
      <div class="col-md-6 mb-3">
        <%= f.label :role, "Роль", class: "form-label" %>
        <%= f.select :role, [["Пацієнт", "patient"], ["Адміністратор", "admin"]], {}, class: "form-select" %>
        <div class="form-text">Облікові записи лікарів створюються в розділі «Лікарі та розклади».</div>
      </div>
    <% end %>
  </div>
  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :password, (@user.new_record? ? "Пароль" : "Новий пароль (необов’язково)"), class: "form-label" %>
      <%= f.password_field :password, class: "form-control", autocomplete: "new-password" %>
    </div>
    <div class="col-md-6 mb-3">
      <%= f.label :password_confirmation, "Підтвердження пароля", class: "form-label" %>
      <%= f.password_field :password_confirmation, class: "form-control", autocomplete: "new-password" %>
    </div>
  </div>
  <% if @user.persisted? %>
    <div class="form-check mb-3">
      <%= f.check_box :active, class: "form-check-input" %>
      <%= f.label :active, "Обліковий запис активний (деактивований користувач не може увійти)", class: "form-check-label" %>
    </div>
  <% end %>
  <%= f.submit "Зберегти", class: "btn btn-primary" %>
  <%= link_to "Скасувати", admin_users_path, class: "btn btn-link" %>
<% end %>
