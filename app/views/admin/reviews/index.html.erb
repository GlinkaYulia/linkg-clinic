<% content_for :title, "Відгуки" %>
<h1 class="h3 mb-3">Модерація відгуків</h1>
<% if @reviews.empty? %><div class="alert alert-info">Відгуків ще немає.</div><% end %>
<% @reviews.each do |r| %>
  <div class="card shadow-sm mb-2"><div class="card-body d-flex justify-content-between align-items-start gap-3">
    <div>
      <span class="text-warning"><%= stars(r.rating) %></span>
      <strong class="ms-1"><%= r.patient.full_name %></strong> про <strong><%= r.doctor_profile.full_name %></strong>
      <span class="text-muted small ms-1"><%= fmt_date(r.created_at.to_date) %></span>
      <% if r.hidden? %><span class="badge text-bg-secondary ms-1">приховано</span><% end %>
      <p class="mb-0"><%= r.body %></p>
    </div>
    <%= button_to (r.published? ? "Приховати" : "Опублікувати"), toggle_admin_review_path(r), method: :patch,
                  class: "btn btn-sm btn-outline-secondary", form_class: "d-inline" %>
  </div></div>
<% end %>
