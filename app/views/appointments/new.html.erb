<% content_for :title, "Оформлення візиту" %>
<h1 class="h3 mb-3">Оформлення візиту</h1>
<%= render "shared/errors", record: @appointment %>

<div class="row g-3">
  <div class="col-lg-5 order-lg-2">
    <div class="card shadow-sm">
      <div class="card-header fw-semibold">Ваше замовлення</div>
      <div class="card-body">
        <p class="mb-1"><strong><%= @doctor.full_name %></strong>
          <span class="badge text-bg-info"><%= @doctor.specialty.name %></span></p>
        <p class="mb-3"><%= weekday_name(@starts_at.to_date) %>, <%= fmt_dt(@starts_at) %> · кабінет <%= @doctor.room %></p>
        <table class="table table-sm mb-2">
          <tbody>
            <tr><td>Консультація лікаря</td><td class="text-end"><%= fmt_money(@doctor.consultation_price) %></td></tr>
            <% cart_services.each do |s| %>
              <tr><td><%= s.name %></td><td class="text-end"><%= fmt_money(s.price) %></td></tr>
            <% end %>
            <tr class="table-light"><th>Разом (без доставки)</th>
              <th class="text-end"><%= fmt_money(@doctor.consultation_price + cart_services.sum(&:price)) %></th></tr>
          </tbody>
        </table>
        <p class="small text-muted mb-0">
          Послуги беруться з <%= link_to "кошика", cart_path %> (<%= cart_count %>).
          Вартість доставки результатів додається до суми залежно від обраного способу.
        </p>
      </div>
    </div>
  </div>

  <div class="col-lg-7 order-lg-1">
    <div class="card shadow-sm"><div class="card-body">
      <%= form_with model: @appointment, url: doctor_appointments_path(@doctor), method: :post do |f| %>
        <%= hidden_field_tag :starts_at, @starts_at.iso8601 %>

        <h2 class="h5">Спосіб отримання результатів</h2>
        <% Appointment::DELIVERY_LABELS.each do |key, label| %>
          <div class="form-check">
            <%= f.radio_button :delivery_method, key, class: "form-check-input", id: "delivery_#{key}" %>
            <label class="form-check-label" for="delivery_<%= key %>">
              <%= label %> — <strong><%= Appointment::DELIVERY_FEES[key].zero? ? "безкоштовно" : fmt_money(Appointment::DELIVERY_FEES[key]) %></strong>
            </label>
          </div>
        <% end %>
        <div class="mt-2 mb-3">
          <%= f.label :delivery_address, "Адреса (для відправлення поштою)", class: "form-label" %>
          <%= f.text_field :delivery_address, class: "form-control", placeholder: "Місто, відділення Нової пошти" %>
        </div>

        <h2 class="h5">Спосіб оплати</h2>
        <% Appointment::PAYMENT_METHOD_LABELS.each do |key, label| %>
          <div class="form-check">
            <%= f.radio_button :payment_method, key, class: "form-check-input", id: "payment_#{key}" %>
            <label class="form-check-label" for="payment_<%= key %>"><%= label %></label>
          </div>
        <% end %>

        <div class="mt-3 mb-3">
          <%= f.label :comment, "Коментар до візиту (необов’язково)", class: "form-label" %>
          <%= f.text_area :comment, rows: 2, class: "form-control" %>
        </div>
        <%= f.submit "Підтвердити запис", class: "btn btn-primary btn-lg" %>
        <%= link_to "Назад", doctor_path(@doctor), class: "btn btn-link" %>
      <% end %>
    </div></div>
  </div>
</div>
