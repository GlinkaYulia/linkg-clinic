<% content_for :title, @patient.full_name %>
<%= link_to "← До списку пацієнтів", doctor_patients_path, class: "small" %>
<h1 class="h3 mt-2"><%= @patient.full_name %></h1>
<p class="text-muted">
  <%= @patient.phone %> · <%= @patient.email %>
  <% if @patient.birth_date %> · народжений(а) <%= fmt_date(@patient.birth_date) %><% end %>
</p>

<h2 class="h5 mt-4">Історія хвороби</h2>
<% if @history.empty? %>
  <div class="alert alert-info">Завершених візитів ще немає.</div>
<% end %>
<% @history.each do |a| %>
  <div class="card shadow-sm mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
      <span>
        <strong><%= fmt_dt(a.starts_at) %></strong> · <%= a.doctor_profile.full_name %>
        <span class="badge text-bg-info"><%= a.doctor_profile.specialty.name %></span>
      </span>
      <% if a.medical_record && a.doctor_profile_id == @doctor_profile.id && a.medical_record.editable? %>
        <%= link_to "Редагувати", edit_doctor_appointment_medical_record_path(a), class: "btn btn-sm btn-outline-secondary" %>
      <% end %>
    </div>
    <% if a.medical_record %>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-sm-3">Скарги</dt><dd class="col-sm-9"><%= a.medical_record.complaints %></dd>
          <dt class="col-sm-3">Діагноз</dt><dd class="col-sm-9"><%= a.medical_record.diagnosis %></dd>
          <dt class="col-sm-3">Призначення</dt><dd class="col-sm-9"><%= a.medical_record.prescription %></dd>
        </dl>
      </div>
    <% end %>
  </div>
<% end %>
