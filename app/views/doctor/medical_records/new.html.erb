<% content_for :title, "Медичний запис" %>
<h1 class="h3 mb-1">Медичний запис</h1>
<p class="text-muted">
  Пацієнт: <strong><%= @appointment.patient.full_name %></strong> · прийом <%= fmt_dt(@appointment.starts_at) %>
  · <%= link_to "історія хвороби", doctor_patient_path(@appointment.patient) %>
</p>
<div class="card shadow-sm col-lg-8"><div class="card-body">
  <%= render "form", record: @record, appointment: @appointment, method: :post, submit_label: "Зберегти й завершити візит" %>
</div></div>
