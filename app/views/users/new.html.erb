<% content_for :title, "Реєстрація" %>
<div class="row justify-content-center">
  <div class="col-md-8 col-lg-6">
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="auth-icon"><%= icon_tag "person-plus" %></div>
        <h1 class="h4 mb-3 text-center">Реєстрація пацієнта</h1>
        <%= render "shared/errors", record: @user %>
        <%= form_with model: @user, url: register_path, method: :post do |f| %>
          <div class="mb-3">
            <%= f.label :full_name, "ПІБ", class: "form-label" %>
            <%= f.text_field :full_name, class: "form-control", required: true %>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <%= f.label :email, "Email", class: "form-label" %>
              <%= f.email_field :email, class: "form-control", required: true %>
            </div>
            <div class="col-md-6 mb-3">
              <%= f.label :phone, "Телефон", class: "form-label" %>
              <%= f.telephone_field :phone, class: "form-control", required: true %>
            </div>
          </div>
          <div class="mb-3">
            <%= f.label :birth_date, "Дата народження", class: "form-label" %>
            <%= f.date_field :birth_date, class: "form-control", required: true %>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <%= f.label :password, "Пароль (мінімум 8 символів)", class: "form-label" %>
              <%= f.password_field :password, class: "form-control", required: true, minlength: 8 %>
            </div>
            <div class="col-md-6 mb-3">
              <%= f.label :password_confirmation, "Підтвердження пароля", class: "form-label" %>
              <%= f.password_field :password_confirmation, class: "form-control", required: true %>
            </div>
          </div>
          <%= f.submit "Зареєструватися", class: "btn btn-primary" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
