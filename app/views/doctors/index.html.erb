<% content_for :title, "Лікарі" %>
<h1 class="h3 mb-3">Лікарі</h1>

<%= form_with url: doctors_path, method: :get, class: "row g-2 mb-4" do |f| %>
  <div class="col-sm-6 col-md-4">
    <%= f.text_field :q, value: params[:q], placeholder: "Пошук за прізвищем…", class: "form-control" %>
  </div>
  <div class="col-sm-6 col-md-4">
    <%= f.select :specialty_id, options_from_collection_for_select(@specialties, :id, :name, params[:specialty_id]),
                 { include_blank: "Усі спеціальності" }, class: "form-select" %>
  </div>
  <div class="col-auto">
    <%= f.submit "Показати", name: nil, class: "btn btn-primary" %>
  </div>
<% end %>

<% if @doctors.empty? %>
  <div class="alert alert-info">Лікарів за обраною спеціальністю не знайдено.</div>
<% end %>

<div class="row row-cols-1 row-cols-lg-2 g-3">
  <% @doctors.each do |doctor| %>
    <div class="col">
      <div class="card card-hover h-100">
        <div class="card-body d-flex gap-3">
          <%= doctor_avatar(doctor, size: 76) %>
          <div>
          <h2 class="h5 mb-1"><%= doctor.full_name %></h2>
          <p class="mb-2">
            <span class="badge text-bg-info"><%= icon_tag specialty_icon(doctor.specialty.name) %> <%= doctor.specialty.name %></span>
            <span class="text-muted ms-1 small">кабінет <%= doctor.room %></span>
          </p>
          <p class="mb-2">
            <% if @ratings[doctor.id] %>
              <span class="text-warning"><%= stars(@ratings[doctor.id]) %></span>
              <strong><%= @ratings[doctor.id].to_f.round(1) %></strong>
              <span class="text-muted small">(відгуків: <%= @review_counts[doctor.id] %>)</span>
            <% else %>
              <span class="text-muted small">Відгуків ще немає</span>
            <% end %>
          </p>
          <p class="card-text"><%= doctor.bio %></p>
          <p class="mb-0">Консультація: <strong><%= fmt_money(doctor.consultation_price) %></strong></p>
          </div>
        </div>
        <div class="card-footer bg-white">
          <%= link_to "Обрати час", doctor_path(doctor), class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
