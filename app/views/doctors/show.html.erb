<% content_for :title, @doctor.full_name %>
<%= link_to "← До списку лікарів", doctors_path, class: "small" %>
<div class="card mt-2 mb-3"><div class="card-body d-flex gap-3 align-items-center flex-wrap">
  <%= doctor_avatar(@doctor, size: 96) %>
  <div>
    <h1 class="h3 mb-1"><%= @doctor.full_name %></h1>
    <p class="mb-1">
      <span class="badge text-bg-info"><%= icon_tag specialty_icon(@doctor.specialty.name) %> <%= @doctor.specialty.name %></span>
      <span class="text-muted ms-1">кабінет <%= @doctor.room %></span>
    </p>
    <p class="mb-1 text-body-secondary"><%= @doctor.bio %></p>
    <p class="mb-0">Консультація: <strong><%= fmt_money(@doctor.consultation_price) %></strong>
      <% if @average %>
        · <span class="text-warning"><%= stars(@average) %></span> <strong><%= @average.to_f.round(1) %></strong>
        <span class="text-muted small">(відгуків: <%= @reviews_count %>)</span>
      <% end %>
    </p>
  </div>
</div></div>

<h2 class="h5 mt-4">Вільні слоти на найближчі 14 днів</h2>

<% if current_user.nil? %>
  <div class="alert alert-warning">
    Щоб записатися, <%= link_to "увійдіть", login_path %> або <%= link_to "зареєструйтеся", register_path %>.
  </div>
<% elsif !current_user.patient? %>
  <div class="alert alert-secondary">Запис на прийом доступний лише для пацієнтів.</div>
<% end %>

<% if @slots.empty? %>
  <div class="alert alert-info">Вільних слотів поки немає.</div>
<% end %>

<% @slots.each do |date, times| %>
  <div class="card shadow-sm mb-3">
    <div class="card-header fw-semibold"><%= weekday_name(date) %>, <%= fmt_date(date) %></div>
    <div class="card-body d-flex flex-wrap gap-2">
      <% times.each do |time| %>
        <% if current_user&.patient? %>
          <%= link_to fmt_time(time), new_doctor_appointment_path(@doctor, starts_at: time.iso8601),
                      class: "btn btn-outline-primary btn-sm slot-btn" %>
        <% else %>
          <span class="badge text-bg-light border fs-6 rounded-pill"><%= fmt_time(time) %></span>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<h2 class="h5 mt-4">Відгуки пацієнтів</h2>
<% if @reviews.empty? %>
  <p class="text-muted">Відгуків ще немає.</p>
<% end %>
<% @reviews.each do |r| %>
  <div class="card shadow-sm mb-2"><div class="card-body py-2">
    <span class="text-warning"><%= stars(r.rating) %></span>
    <strong class="ms-1"><%= short_name(r.patient.full_name) %></strong>
    <span class="text-muted small ms-1"><%= fmt_date(r.created_at.to_date) %></span>
    <p class="mb-0"><%= r.body %></p>
  </div></div>
<% end %>
