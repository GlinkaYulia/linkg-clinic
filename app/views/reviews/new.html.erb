<% content_for :title, "Відгук про лікаря" %>
<h1 class="h3 mb-1">Відгук про лікаря</h1>
<p class="text-muted"><%= @appointment.doctor_profile.full_name %> · візит <%= fmt_dt(@appointment.starts_at) %></p>
<div class="card shadow-sm col-lg-7"><div class="card-body">
  <%= render "shared/errors", record: @review %>
  <%= form_with model: @review, url: appointment_review_path(@appointment), method: :post do |f| %>
    <div class="mb-3">
      <%= f.label :rating, "Оцінка", class: "form-label" %>
      <%= f.select :rating, [["5 — відмінно", 5], ["4 — добре", 4], ["3 — задовільно", 3], ["2 — погано", 2], ["1 — дуже погано", 1]], {}, class: "form-select" %>
    </div>
    <div class="mb-3">
      <%= f.label :body, "Ваш відгук (мінімум 10 символів)", class: "form-label" %>
      <%= f.text_area :body, rows: 5, class: "form-control" %>
    </div>
    <%= f.submit "Надіслати відгук", class: "btn btn-primary" %>
    <%= link_to "Скасувати", history_path, class: "btn btn-link" %>
  <% end %>
</div></div>
